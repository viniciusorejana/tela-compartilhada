{
  "name": "sala-compartilhada-app",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicativo de mesa do Nexo: a mesma sala, fora do navegador, para que o cliente possa ficar fora da captura de audio.",
  "main": "main.js",
  "scripts": {
    "start": "node lancar.js",
    "empacotar": "electron-builder --win portable",
    "empacotar:linux": "electron-builder --linux AppImage",
    "empacotar:mac": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.telacompartilhada.app",
    "productName": "Nexo",
    "files": [
      "main.js",
      "preload.js",
      "endereco.html",
      "escolher.html",
      "package.json",
      "lancar.js",
      "icon.ico"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        "portable"
      ],
      "extraResources": [
        {
          "from": "../native/audio-agent/x64/Release/AgenteAudio.exe",
          "to": "AgenteAudio.exe"
        }
      ]
    },
    "portable": {
      "artifactName": "SalaCompartilhada.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "artifactName": "Nexo.AppImage"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.social-networking",
      "artifactName": "Nexo.dmg"
    },
    "dmg": {
      "artifactName": "Nexo.dmg"
    }
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  }
}
