<?xml version="1.0" encoding="utf-8"?>
<!-- Manifesto explicito. Declarar que o programa NAO pede elevacao e que ele conhece as
     versoes atuais do Windows sao sinais a favor na hora em que o antivirus decide se um
     executavel sem assinatura e confiavel. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="TelaCompartilhada.AgenteAudio" version="1.1.0.0" processorArchitecture="amd64"/>
  <description>Agente de audio da sala de tela compartilhada</description>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 e 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
    </application>
  </compatibility>
</assembly>
