<?xml version="1.0" encoding="utf-8"?>
<!-- Nada vai para o backup na nuvem nem passa para um celular novo: a sessão da conta mora nos
     cookies da WebView, e levá-la junto seria entrar na conta de alguém em outro aparelho. No
     celular novo, basta entrar de novo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
