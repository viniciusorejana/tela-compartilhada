{
  "name": "tela-compartilhada",
  "version": "1.0.0",
  "description": "Servidor de compartilhamento de tela ao vivo (com audio) via WebRTC",
  "main": "server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.dev server.js",
    "start": "node --env-file-if-exists=.env.prod scripts/baixar-livekit.cjs && node --env-file-if-exists=.env.prod server.js",
    "start:dev": "node --env-file-if-exists=.env.dev scripts/baixar-livekit.cjs && node --env-file-if-exists=.env.dev server.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.cjs",
    "test:recursos": "node tests/recursos-sala-browser.cjs",
    "test:electron": "node tests/electron.cjs",
    "test:download": "node tests/download-browser.cjs",
    "test:soundboard": "node tests/soundboard-browser.cjs",
    "test:painel": "node tests/painel-browser.cjs",
    "test:contas": "node tests/contas-browser.cjs",
    "test:planos": "node tests/planos-browser.cjs",
    "test:fila": "node tests/fila-e-perfil-browser.cjs",
    "test:volume": "node tests/volume-browser.cjs",
    "banda": "node scripts/relatorio-de-banda.cjs",
    "painel:chave": "node --env-file-if-exists=.env.prod scripts/painel-chave.cjs",
    "painel:chave:dev": "node --env-file-if-exists=.env.dev scripts/painel-chave.cjs",
    "build:icon": "node scripts/build-icon.cjs",
    "build:helper": "powershell -ExecutionPolicy Bypass -File .\\build-helper.ps1",
    "build:sfu": "node scripts/baixar-livekit.cjs",
    "musica:instalar": "node scripts/baixar-musica.cjs",
    "musica:atualizar": "node scripts/baixar-musica.cjs --atualizar",
    "sons:compor": "node scripts/sons/compor.cjs"
  },
  "dependencies": {
    "@jitsi/rnnoise-wasm": "0.2.1",
    "@livekit/rtc-node": "^1.0.0",
    "express": "^4.19.2",
    "livekit-client": "^2.22.3",
    "socket.io": "^4.7.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  },
  "overrides": {
    "express": {
      "qs": "^6.16.0"
    }
  }
}
