{
  "name": "tela-compartilhada",
  "version": "1.0.0",
  "description": "Servidor de compartilhamento de tela ao vivo (com audio) via WebRTC",
  "main": "server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.dev server.js",
    "start": "node --env-file-if-exists=.env.prod scripts/baixar-livekit.cjs && node --env-file-if-exists=.env.prod server.js",
    "start:dev": "node --env-file-if-exists=.env.dev scripts/baixar-livekit.cjs && node --env-file-if-exists=.env.dev server.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.cjs",
    "test:recursos": "node tests/recursos-sala-browser.cjs",
    "test:electron": "node tests/electron.cjs",
    "test:splash": "node tests/splash-electron.cjs",
    "test:bandeja": "node tests/bandeja-electron.cjs",
    "test:download": "node tests/download-browser.cjs",
    "test:soundboard": "node tests/soundboard-browser.cjs",
    "test:painel": "node tests/painel-browser.cjs",
    "test:contas": "node tests/contas-browser.cjs",
    "test:inicio": "node tests/inicio-browser.cjs",
    "test:camada": "node tests/camada-browser.cjs",
    "test:chassi": "node tests/chassi-browser.cjs",
    "test:carregando": "node tests/carregando-browser.cjs",
    "test:foto": "node tests/foto-browser.cjs",
    "test:status": "node tests/status-browser.cjs",
    "test:cor": "node tests/cor-browser.cjs",
    "test:emojis": "node tests/emojis-browser.cjs",
    "test:planos": "node tests/planos-browser.cjs",
    "test:fila": "node tests/fila-e-perfil-browser.cjs",
    "test:volume": "node tests/volume-browser.cjs",
    "test:espectadores": "node tests/espectadores-browser.cjs",
    "test:aparencia": "node tests/aparencia-browser.cjs",
    "test:layout": "node tests/layout-browser.cjs",
    "test:redimensionar": "node tests/redimensionar-browser.cjs",
    "test:conversa": "node tests/conversa-browser.cjs",
    "test:cartao-sala": "node tests/cartao-na-sala-browser.cjs",
    "test:atividade": "node tests/atividade-browser.cjs",
    "test:audio-tela": "node tests/audio-tela-browser.cjs",
    "test:servidor": "node tests/servidor-app-browser.cjs",
    "test:novidades": "node tests/novidades-browser.cjs",
    "test:estudio": "node tests/estudio-browser.cjs",
    "test:webcodecs": "node tests/webcodecs-browser.cjs",
    "test:webcodecs:placa": "node tests/webcodecs-placa.cjs",
    "test:android": "node tests/android-browser.cjs",
    "banda": "node scripts/relatorio-de-banda.cjs",
    "painel:chave": "node --env-file-if-exists=.env.prod scripts/painel-chave.cjs",
    "painel:chave:dev": "node --env-file-if-exists=.env.dev scripts/painel-chave.cjs",
    "build:icon": "node scripts/build-icon.cjs",
    "splash:gerar": "node scripts/gerar-splash.cjs",
    "build:helper": "powershell -ExecutionPolicy Bypass -File .\\build-helper.ps1",
    "build:sfu": "node scripts/baixar-livekit.cjs",
    "android:empacotar": "node --env-file-if-exists=.env.prod scripts/empacotar-android.cjs",
    "servidor:padrao": "node --env-file-if-exists=.env.prod scripts/servidor-padrao.cjs",
    "lancar": "node deploy/lancamento/lancar.cjs",
    "lancar:plano": "node deploy/lancamento/lancar.cjs --plano",
    "musica:instalar": "node scripts/baixar-musica.cjs",
    "musica:atualizar": "node scripts/baixar-musica.cjs --atualizar",
    "sons:compor": "node scripts/sons/compor.cjs",
    "emojis:gerar": "node scripts/gerar-emojis.cjs --baixar",
    "video:instalar": "npm --prefix video install",
    "video:estudio": "npm --prefix video run estudio",
    "video:renderizar": "npm --prefix video run renderizar --"
  },
  "dependencies": {
    "@jitsi/rnnoise-wasm": "0.2.1",
    "@livekit/rtc-node": "^1.0.0",
    "express": "^4.19.2",
    "livekit-client": "^2.22.3",
    "socket.io": "^4.7.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  },
  "overrides": {
    "express": {
      "qs": "^6.16.0"
    }
  }
}
